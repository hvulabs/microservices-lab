NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_POOL_MAX=50
COMPOSE_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/postgres
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
GATEWAY_PORT=3000
ORDER_SERVICE_PORT=3001
WALLET_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
MOCK_PSP_PORT=3005
ORDER_SERVICE_URL=http://127.0.0.1:3001
WALLET_SERVICE_URL=http://127.0.0.1:3002
PAYMENT_SERVICE_URL=http://127.0.0.1:3003
MOCK_PSP_URL=http://127.0.0.1:3005
MOCK_PSP_MODE=success
MOCK_PSP_DELAY_MS=1000
MOCK_PSP_WEBHOOK_SECRET=local-dev-webhook-secret
