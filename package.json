{
  "name": "payment-lab",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint apps libs web --ext .ts,.tsx",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:int": "pnpm -r --if-present test:int",
    "dev:all": "pnpm exec supabase start && docker compose up --build",
    "stop:all": "docker compose down && pnpm exec supabase stop",
    "dev:infra": "docker compose up -d rabbitmq redis",
    "stop:infra": "docker compose down",
    "dev:gateway": "nest start gateway --watch",
    "dev:order-service": "nest start order-service --watch",
    "dev:wallet-service": "nest start wallet-service --watch",
    "dev:payment-service": "nest start payment-service --watch",
    "dev:notification-service": "nest start notification-service --watch",
    "dev:mock-psp": "nest start mock-psp --watch",
    "dev:web": "pnpm --filter @lab/web dev",
    "build:web": "pnpm --filter @lab/web build"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/amqplib": "^0.10.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "supabase": "2.121.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.15.0"
  }
}
